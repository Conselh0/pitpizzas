<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Pit Pizzas</title>
    <link rel="icon" href="~/img/logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <a asp-controller="Pizza" asp-action="Index" class="marca">
            <img src="~/img/logo.png" alt="Logo Pit Pizzas" class="logo" />
        </a>
        <div class="titulo">
            <h1>Monte a sua pizza</h1>
            <p>Escolha a massa, os ingredientes e os adicionais. Do seu jeito!</p>
        </div>
    </header>

    <main class="conteudo">
        @RenderBody()
    </main>

    <footer class="rodape">© @DateTime.Now.Year Pit Pizzas</footer>
</body>
</html>
